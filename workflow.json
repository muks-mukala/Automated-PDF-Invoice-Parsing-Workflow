    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.text;\n\nconst invoiceMatch = rawText.match(/#\\s*([0-9]+)/i);\nconst clientMatch = rawText.match(/Bill To:\\s*([A-Za-z\\s]+?)(?=\\s+[A-Za-z]{3}\\s+\\d{2},\\s+\\d{4})/i);\nconst dateMatch = rawText.match(/([A-Za-z]{3}\\s+\\d{2},\\s+\\d{4})/i);\nconst totalMatch = rawText.match(/(US\\$[0-9]+\\.[0-9]{2})/i);\n\nreturn {\n  json: {\n    invoiceNumber: invoiceMatch ? invoiceMatch[1].trim() : \"\",\n    client: clientMatch ? clientMatch[1].trim() : \"\",\n    date: dateMatch ? dateMatch[1].trim() : \"\",\n    total: totalMatch ? totalMatch[1].trim() : \"\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
